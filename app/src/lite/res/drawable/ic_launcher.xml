<?xml version="1.0" encoding="utf-8"?>
<!-- Lite icon: wahi S logo, gird halki green frame pehchan ke liye -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item
        android:bottom="11dp"
        android:left="11dp"
        android:right="11dp"
        android:top="11dp">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/logo_mark" />
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="3dp"
                android:color="#58B531" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</layer-list>
